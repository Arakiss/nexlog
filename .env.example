# ========================================
# nexlog Environment Configuration
# Optimized for Bun Runtime
# ========================================
# Copy this file to .env.local, .env.development, .env.production, etc.
# All variables are optional - nexlog will use sensible defaults
# Works seamlessly with Bun, Node.js, and Edge runtimes

# ========================================
# Core Settings
# ========================================

# Log level: trace | debug | info | warn | error | fatal
# Default: info (warn in production)
NEXLOG_LEVEL=info

# Enable/disable all logging
# Default: true
NEXLOG_ENABLED=true

# Only log on server-side rendering (disables client & edge)
# Default: false
NEXLOG_SSR_ONLY=false

# Enable client-side (browser) logging
# Default: true
NEXLOG_CLIENT_ENABLED=true

# Enable edge runtime logging (Vercel Edge, Cloudflare Workers, etc.)
# Default: true
NEXLOG_EDGE_ENABLED=true

# ========================================
# Output Settings
# ========================================

# Use JSON structured logging (recommended for production)
# Default: false (true in production)
NEXLOG_STRUCTURED=false

# Use colors in console output (server only)
# Default: true
NEXLOG_COLORS=true

# Default namespace for all loggers
# Example: "my-app" will prefix all logs with [my-app]
NEXLOG_NAMESPACE=

# Prefix for all log messages
# Example: "[APP]" will prefix all messages
NEXLOG_PREFIX=

# ========================================
# Performance Settings
# ========================================

# Sampling rate (0-1): 0.1 = log 10% of messages, 1 = log all
# Useful for high-volume production environments
# Default: 1
NEXLOG_SAMPLING_RATE=1

# Batch size for batched transport
# Default: 100
NEXLOG_BATCH_SIZE=100

# Flush interval in milliseconds
# Default: 1000 (1 second)
NEXLOG_FLUSH_INTERVAL=1000

# Maximum queue size for batching
# Default: 1000
NEXLOG_MAX_QUEUE_SIZE=1000

# ========================================
# Feature Flags
# ========================================

# Enable DevTools component in production
# Default: false
NEXLOG_DEV_TOOLS=false

# Log application lifecycle events (start, stop, network, etc.)
# Default: true
NEXLOG_LIFECYCLE=true

# Include performance metrics (memory, timing)
# Default: false (true in development)
NEXLOG_PERFORMANCE=false

# Include stack traces in error logs
# Default: true
NEXLOG_STACK_TRACES=true

# ========================================
# Transport Settings
# ========================================

# Comma-separated list of transports to use
# Options: console, file, http (only console is implemented by default)
# Default: console
NEXLOG_TRANSPORTS=console

# Enable console transport explicitly
# Default: true
NEXLOG_CONSOLE_ENABLED=true

# HTTP endpoint for remote logging (if using HTTP transport)
# Example: https://api.example.com/logs
NEXLOG_HTTP_ENDPOINT=

# ========================================
# Filtering
# ========================================

# Comma-separated regex patterns - only log messages matching these patterns
# Example: "API.*,Database.*" will only log API and Database messages
NEXLOG_INCLUDE_PATTERNS=

# Comma-separated regex patterns - exclude messages matching these patterns
# Example: "health.*,ping" will exclude health checks and ping logs
NEXLOG_EXCLUDE_PATTERNS=

# ========================================
# Context Variables
# ========================================
# Any variable starting with NEXLOG_CONTEXT_ will be added to log context
# Values can be strings or JSON

# Examples:
NEXLOG_CONTEXT_VERSION=1.0.0
NEXLOG_CONTEXT_ENVIRONMENT=development
NEXLOG_CONTEXT_REGION=us-west-2
NEXLOG_CONTEXT_SERVICE=api
# JSON example (will be parsed):
# NEXLOG_CONTEXT_METADATA={"team":"backend","owner":"john@example.com"}

# ========================================
# Development Settings
# ========================================

# Enable debug output (shows configuration on startup)
# Default: false
NEXLOG_DEBUG=false

# Enable verbose output
# Default: false
NEXLOG_VERBOSE=false

# ========================================
# Common Configuration Scenarios
# ========================================

# === Production (High Volume) ===
# NEXLOG_LEVEL=warn
# NEXLOG_STRUCTURED=true
# NEXLOG_SSR_ONLY=true
# NEXLOG_SAMPLING_RATE=0.1
# NEXLOG_BATCH_SIZE=500
# NEXLOG_FLUSH_INTERVAL=5000
# NEXLOG_STACK_TRACES=false
# NEXLOG_PERFORMANCE=false

# === Production (Critical Service) ===
# NEXLOG_LEVEL=info
# NEXLOG_STRUCTURED=true
# NEXLOG_SAMPLING_RATE=1
# NEXLOG_HTTP_ENDPOINT=https://logs.example.com
# NEXLOG_CONTEXT_SERVICE=payment-gateway

# === Development ===
# NEXLOG_LEVEL=trace
# NEXLOG_COLORS=true
# NEXLOG_DEV_TOOLS=true
# NEXLOG_PERFORMANCE=true
# NEXLOG_DEBUG=true

# === Testing ===
# NEXLOG_ENABLED=false

# === Client-Only App ===
# NEXLOG_SSR_ONLY=false
# NEXLOG_CLIENT_ENABLED=true
# NEXLOG_EDGE_ENABLED=false

# === Server-Only API ===
# NEXLOG_SSR_ONLY=true
# NEXLOG_CLIENT_ENABLED=false

# === Debug Specific Module ===
# NEXLOG_LEVEL=trace
# NEXLOG_INCLUDE_PATTERNS=AuthService.*,Database.*
# NEXLOG_EXCLUDE_PATTERNS=health.*