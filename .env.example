# nexlog Environment Configuration
# Copy this file to .env.local and customize for your environment

# ============================================
# Core Settings
# ============================================

# Log level: trace | debug | info | warn | error | fatal
NEXLOG_LEVEL=info

# Enable/disable all logging
NEXLOG_ENABLED=true

# Only log on server-side (disable client logging)
NEXLOG_SSR_ONLY=false

# Enable browser logging
NEXLOG_CLIENT_ENABLED=true

# Enable edge runtime logging
NEXLOG_EDGE_ENABLED=true

# ============================================
# Output Settings
# ============================================

# JSON structured logging (recommended for production)
NEXLOG_STRUCTURED=false

# Colored console output (disable in CI/production)
NEXLOG_COLORS=true

# Default namespace for all logs
# NEXLOG_NAMESPACE=my-app

# Prefix for all log messages
# NEXLOG_PREFIX=[APP]

# ============================================
# Performance Settings
# ============================================

# Log sampling rate (0-1, where 1 = log everything)
NEXLOG_SAMPLING_RATE=1

# Batch size before flushing logs
NEXLOG_BATCH_SIZE=100

# Flush interval in milliseconds
NEXLOG_FLUSH_INTERVAL=1000

# Maximum queue size for batched logs
NEXLOG_MAX_QUEUE_SIZE=1000

# ============================================
# Features
# ============================================

# Enable DevTools component in production (use with caution)
NEXLOG_DEV_TOOLS=false

# Log app lifecycle events (start, stop, errors)
NEXLOG_LIFECYCLE=true

# Include performance metrics in logs
NEXLOG_PERFORMANCE=false

# Include stack traces in error logs
NEXLOG_STACK_TRACES=true

# Enable verbose/debug mode for nexlog itself
NEXLOG_DEBUG=false
NEXLOG_VERBOSE=false

# ============================================
# Filtering
# ============================================

# Include only logs matching these patterns (comma-separated regex)
# NEXLOG_INCLUDE_PATTERNS=API.*,Database.*

# Exclude logs matching these patterns (comma-separated regex)
# NEXLOG_EXCLUDE_PATTERNS=health.*,ping

# ============================================
# Remote Logging
# ============================================

# HTTP endpoint for remote log collection
# NEXLOG_HTTP_ENDPOINT=https://logs.example.com/ingest

# ============================================
# Context (automatically added to all logs)
# ============================================

# Service name
# NEXLOG_CONTEXT_SERVICE=api

# Service version
# NEXLOG_CONTEXT_VERSION=1.0.0

# Environment name
# NEXLOG_CONTEXT_ENVIRONMENT=production

# Deployment region
# NEXLOG_CONTEXT_REGION=us-west-2

# Custom context (any NEXLOG_CONTEXT_* variable is included)
# NEXLOG_CONTEXT_TEAM=platform
# NEXLOG_CONTEXT_INSTANCE=pod-1234

# ============================================
# Example Configurations
# ============================================

# Production (high volume):
# NEXLOG_LEVEL=warn
# NEXLOG_STRUCTURED=true
# NEXLOG_SSR_ONLY=true
# NEXLOG_SAMPLING_RATE=0.1
# NEXLOG_BATCH_SIZE=500

# Development:
# NEXLOG_LEVEL=trace
# NEXLOG_COLORS=true
# NEXLOG_DEV_TOOLS=true
# NEXLOG_DEBUG=true

# Testing:
# NEXLOG_ENABLED=false
# Or use minimal logging:
# NEXLOG_LEVEL=error
# NEXLOG_STRUCTURED=true
