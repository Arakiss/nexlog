{
	"name": "nexlog",
	"version": "5.3.0",
	"description": "A simple and effective logging library for Next.js, compatible with server, browser, and edge environments.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"edge-runtime": "./dist/edge.js",
			"edge-light": "./dist/edge.js",
			"worker": "./dist/edge.js",
			"node": {
				"import": "./dist/index.js",
				"require": "./dist/index.cjs"
			},
			"browser": "./dist/browser.js",
			"default": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./edge": {
			"import": "./dist/edge.js",
			"types": "./dist/edge.d.ts"
		},
		"./node": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./react": {
			"import": "./dist/react/logger-provider.js",
			"types": "./dist/react/logger-provider.d.ts"
		},
		"./sanitizer": {
			"import": "./dist/sanitizer/index.js",
			"types": "./dist/sanitizer/index.d.ts"
		},
		"./context": {
			"import": "./dist/context/index.js",
			"types": "./dist/context/index.d.ts"
		},
		"./types": {
			"import": "./dist/types.js",
			"types": "./dist/types.d.ts"
		},
		"./browser": {
			"import": "./dist/browser.js",
			"types": "./dist/browser.d.ts"
		},
		"./formatters": {
			"import": "./dist/formatters/index.js",
			"types": "./dist/formatters/index.d.ts"
		},
		"./utils": {
			"import": "./dist/utils/index.js",
			"types": "./dist/utils/index.d.ts"
		},
		"./correlation": {
			"import": "./dist/correlation/index.js",
			"types": "./dist/correlation/index.d.ts"
		},
		"./config": {
			"import": "./dist/config.js",
			"types": "./dist/config.d.ts"
		},
		"./transports": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"typecheck": "tsc --noEmit",
		"build": "bun run build:clean && bun run build:compile",
		"build:clean": "rm -rf dist",
		"build:compile": "tsc",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check .",
		"ci": "bun run check && bun run typecheck && bun test && bun run build",
		"prepublishOnly": "bun run ci",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.2",
		"@changesets/cli": "^2.29.6",
		"@types/node": "^22.18.0",
		"@types/react": "^18.3.24",
		"@types/react-dom": "^19.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.5",
		"react-dom": "^19.1.1",
		"typescript": "^5.9.2"
	},
	"peerDependencies": {
		"typescript": "^5.0.0",
		"react": "^19.1.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Arakiss/nexlog.git"
	},
	"bugs": {
		"url": "https://github.com/Arakiss/nexlog/issues"
	},
	"homepage": "https://github.com/Arakiss/nexlog#readme",
	"keywords": [
		"logging",
		"next.js",
		"typescript",
		"bun",
		"logger",
		"node",
		"javascript",
		"library"
	],
	"author": "Arakiss",
	"license": "MIT",
	"engines": {
		"bun": ">=0.1.0"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/Arakiss"
	},
	"publishConfig": {
		"access": "public"
	}
}
